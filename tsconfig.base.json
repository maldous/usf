      ],
      "@foundation/capability-resources": [
        "capabilities/resources/src/index.ts"
      ],
      "@foundation/capability-search": [
        "capabilities/search/src/index.ts"
      ],
      "@foundation/capability-tenant": [
        "capabilities/tenant/src/index.ts"
      ],
      "@foundation/client": [
        "packages/client/src/index.ts"
      ],
      "@foundation/contracts": [
        "packages/contracts/src/index.ts"
      ],
