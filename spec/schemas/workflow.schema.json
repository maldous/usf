{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:workflow",
  "title": "USF Workflow Schema",
  "description": "Draft JSON Schema for workflow contracts and cross-capability interactions. Each declares its kind (event-workflow-kinds), participants, ordered steps, state transitions, and explicit failure paths and compensation paths, plus related events/interfaces. Workflow ordering, consistency, compensation, and failure semantics are contract-level and MUST NOT be lost in implementation extraction. Governs the ontology concepts Workflow and Event. lifecycleState draft; not active. GOVERNANCE ENVELOPE: instances MUST carry id, title, description, authorityLevel, lifecycleState, ontologyConcepts, taxonomyRefs, vocabularyRefs, and aiGuidance (schema-authoring-standard section 9/11). Envelope fields kind (artefact-kinds) and version are deviated and intentionally not required: this artefact is not a top-level artefact-kind and instance versioning is deferred to instance-topology definition (recorded deviation per schema-authoring-standard section 9.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workflowKind",
    "steps",
    "failurePaths",
    "compensationPaths",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance"
  ],
  "$defs": {
    "eventWorkflowKind": {
      "type": "string",
      "enum": [
        "event",
        "message",
        "workflow",
        "cross-capability-interaction",
        "state-transition",
        "asynchronous-operation",
        "synchronous-operation",
        "failure-path",
        "compensation-path"
      ]
    },
    "workflowStep": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      },
      "$comment": "Deliberate extension point: typed interim shape (id required); the full step shape is deferred to workflow import. Closure validator-deferred."
    },
    "stateTransition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        }
      },
      "$comment": "Deliberate extension point: typed interim shape (from/to required); full transition shape deferred."
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workflowKind": {
      "$ref": "#/$defs/eventWorkflowKind"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflowStep"
      }
    },
    "ordering": {
      "type": "string"
    },
    "stateTransitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateTransition"
      }
    },
    "failurePaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "Explicit failure routes; present (may be empty only with recorded rationale)."
    },
    "compensationPaths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "Explicit compensating actions."
    },
    "relatedEvents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedInterfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "authorityLevel": {
      "type": "string",
      "const": "semantic-definition",
      "$comment": "authority-levels canonical value pinned to this schema's registry authorityRole."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ],
      "$comment": "lifecycle-states canonical values."
    },
    "ontologyConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    }
  }
}
