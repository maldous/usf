{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:workflow",
  "title": "USF Workflow Schema",
  "description": "Draft JSON Schema for workflow contracts and cross-capability interactions. Each declares its kind (event-workflow-kinds), participants, ordered steps, state transitions, and explicit failure paths and compensation paths, plus related events/interfaces. Workflow ordering, consistency, compensation, and failure semantics are contract-level and MUST NOT be lost in implementation extraction. Governs the ontology concepts Workflow and Event. lifecycleState draft; not active. GOVERNANCE ENVELOPE: instances MUST carry id, title, description, authorityLevel, lifecycleState, ontologyConcepts, taxonomyRefs, vocabularyRefs, and aiGuidance (schema-authoring-standard section 9/11). Envelope fields kind (artefact-kinds) and version are deviated and intentionally not required: this artefact is not a top-level artefact-kind and instance versioning is deferred to instance-topology definition (recorded deviation per schema-authoring-standard section 9.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workflowKind",
    "steps",
    "failurePaths",
    "compensationPaths",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance",
    "participants",
    "ordering",
    "stateTransitions"
  ],
  "$defs": {
    "eventWorkflowKind": {
      "type": "string",
      "enum": [
        "event",
        "message",
        "workflow",
        "cross-capability-interaction",
        "state-transition",
        "asynchronous-operation",
        "synchronous-operation",
        "failure-path",
        "compensation-path"
      ]
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          },
          "$comment": "Typed extension map (scalar values) for the deferred full shape."
        }
      },
      "$comment": "Deliberate extension point: typed, CLOSED interim shape; further fields go through the typed scalar extensions map until the full step shape is authored."
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          },
          "$comment": "Typed extension map (scalar values) for the deferred full shape."
        }
      },
      "$comment": "Deliberate extension point: typed, CLOSED interim shape; further fields via the typed scalar extensions map."
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workflowKind": {
      "$ref": "#/$defs/eventWorkflowKind"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "$comment": "Required; may be empty for a workflow with a single implicit participant.",
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflowStep"
      },
      "uniqueItems": true
    },
    "ordering": {
      "type": "string",
      "minLength": 1
    },
    "stateTransitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateTransition"
      },
      "$comment": "Required; may be empty for a workflow with no explicit state machine.",
      "uniqueItems": true
    },
    "failurePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "$comment": "At least one explicit failure path is required.",
      "uniqueItems": true
    },
    "compensationPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "$comment": "At least one explicit compensation path is required; a workflow with no compensating action states that explicitly.",
      "uniqueItems": true
    },
    "relatedEvents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedInterfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "semantic-definition",
      "$comment": "authority-levels canonical value pinned to this schema's registry authorityRole."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ],
      "$comment": "lifecycle-states canonical values."
    },
    "ontologyConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    }
  }
}
