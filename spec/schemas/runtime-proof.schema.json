{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:runtime-proof",
  "title": "USF Runtime Proof Manifest Schema",
  "description": "Draft JSON Schema for bounded runtime proof manifests. Runtime proof manifests record executable API and worker proof modes, service-catalogue linkage, proof commands, teardown obligations, evidence boundaries, deferred boundaries, and explicit non-claims. They support runtime-proof evidence organisation without claiming staging, production, live-provider, SOC, ISO/IEC 27001 certification, full dev readiness, or full React parity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance",
    "issueId",
    "parentIssueId",
    "serviceCatalogueDependency",
    "composeTarget",
    "runtimeModes",
    "providerBindingMatrix",
    "providerSdkBoundary",
    "proofCommands",
    "syntheticDataBoundary",
    "accessBoundary",
    "auditEvidenceBoundary",
    "secretBoundary",
    "tenantBoundary",
    "evidenceGrade",
    "readinessTier",
    "allowedClaims",
    "prohibitedClaims",
    "deferredBoundaries",
    "enterpriseEvidenceSupport",
    "nonClaims"
  ],
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "runtimeMode": {
      "type": "string",
      "enum": ["dev-in-memory", "dev-compose-backed"]
    },
    "evidenceGrade": {
      "type": "string",
      "enum": ["a", "b", "c", "d", "f"]
    },
    "readinessTier": {
      "type": "string",
      "enum": [
        "bounded-dev-runtime-proof",
        "deferred-compose-provider-binding",
        "bounded-compose-provider-binding-proof"
      ]
    },
    "providerMode": {
      "type": "string",
      "enum": ["dev in-memory", "local-composed-real-service"]
    },
    "providerClass": {
      "type": "string",
      "enum": ["hermetic-mock", "local-composed-real-service"]
    },
    "prohibitedClaim": {
      "type": "string",
      "enum": [
        "production-readiness",
        "staging-readiness",
        "live-provider-readiness",
        "soc-readiness",
        "iso27001-certification",
        "full-dev-readiness",
        "full-react-parity",
        "test-readiness",
        "api-runtime-search-binding-readiness",
        "worker-runtime-search-binding-readiness",
        "vector-search-readiness",
        "ai-search-readiness"
      ]
    },
    "allowedClaim": {
      "type": "string",
      "enum": [
        "bounded-api-runtime-proof",
        "bounded-worker-runtime-proof",
        "bounded-compose-boundary-proof",
        "dev-foundation-evidence-support"
      ]
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "proofSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryPoint",
        "packageScript",
        "makeTarget",
        "assertions",
        "auditEvidence",
        "tenantBoundary",
        "accessBoundary",
        "secretBoundary",
        "syntheticDataBoundary",
        "providerBindingEvidence"
      ],
      "properties": {
        "entryPoint": {
          "type": "string",
          "minLength": 1
        },
        "packageScript": {
          "type": "string",
          "minLength": 1
        },
        "makeTarget": {
          "type": "string",
          "minLength": 1
        },
        "assertions": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "auditEvidence": {
          "type": "string",
          "minLength": 1
        },
        "tenantBoundary": {
          "type": "string",
          "minLength": 1
        },
        "accessBoundary": {
          "type": "string",
          "minLength": 1
        },
        "secretBoundary": {
          "type": "string",
          "minLength": 1
        },
        "syntheticDataBoundary": {
          "type": "string",
          "minLength": 1
        },
        "providerBindingEvidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "bindingStatus",
        "serviceCatalogueServiceIds",
        "providerRegistryIds",
        "providerMode",
        "providerClass",
        "adapterName",
        "portName",
        "endpointRef",
        "sdkPackage",
        "sdkVersion",
        "sdkBoundary",
        "sourceUseDisposition",
        "providerRegistryEvidence",
        "apiProofEvidence",
        "workerProofEvidence",
        "deferredReason",
        "followUpIssueRefs",
        "claimBoundary"
      ],
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/kebab"
        },
        "bindingStatus": {
          "type": "string",
          "enum": [
            "active",
            "compose-boundary-only",
            "profile-gated",
            "profile-gated-proven",
            "no-runtime-port",
            "unsupported-deferred"
          ]
        },
        "serviceCatalogueServiceIds": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "providerRegistryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "providerMode": {
          "type": "string",
          "enum": ["in-memory", "composed-test", "live-external-deferred"]
        },
        "providerClass": {
          "type": "string",
          "enum": ["hermetic-mock", "local-composed-real-service", "not-applicable"]
        },
        "adapterName": {
          "type": ["string", "null"]
        },
        "portName": {
          "type": ["string", "null"]
        },
        "endpointRef": {
          "type": ["string", "null"]
        },
        "sdkPackage": {
          "type": ["string", "null"]
        },
        "sdkVersion": {
          "type": ["string", "null"]
        },
        "sdkBoundary": {
          "type": "string",
          "enum": [
            "adapter-package-only",
            "official-cli-proof-boundary",
            "proof-provider-integration-boundary",
            "not-applicable"
          ]
        },
        "sourceUseDisposition": {
          "type": "string",
          "enum": [
            "source-derived-rewrite",
            "new-with-rationale",
            "evidence-only-support",
            "runtime-proof-support"
          ]
        },
        "providerRegistryEvidence": {
          "type": "string",
          "minLength": 1
        },
        "apiProofEvidence": {
          "type": "string",
          "minLength": 1
        },
        "workerProofEvidence": {
          "type": "string",
          "minLength": 1
        },
        "deferredReason": {
          "type": ["string", "null"]
        },
        "followUpIssueRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "claimBoundary": {
          "type": "string",
          "minLength": 1
        },
        "proofCommand": {
          "type": "string",
          "minLength": 1
        },
        "proofEvidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeModeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "providerMode",
        "providerClass",
        "environment",
        "apiProof",
        "workerProof",
        "composeBoundary",
        "serviceCatalogueDependency",
        "evidenceGrade",
        "readinessTier",
        "allowedClaims",
        "prohibitedClaims",
        "providerBindingRefs",
        "deferredProviderBindingRefs",
        "deferredBoundaryRefs",
        "teardown"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/runtimeMode"
        },
        "providerMode": {
          "$ref": "#/$defs/providerMode"
        },
        "providerClass": {
          "$ref": "#/$defs/providerClass"
        },
        "environment": {
          "type": "string",
          "const": "local"
        },
        "apiProof": {
          "$ref": "#/$defs/proofSurface"
        },
        "workerProof": {
          "$ref": "#/$defs/proofSurface"
        },
        "composeBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "target", "serviceCataloguePath", "providerBinding"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "target": {
              "type": ["string", "null"]
            },
            "serviceCataloguePath": {
              "type": "string",
              "const": "spec/instances/compose-service/service-catalogue.json"
            },
            "providerBinding": {
              "type": "string",
              "enum": [
                "not-applicable",
                "runtime-started-with-compose-boundary-provider-binding-deferred",
                "mailpit-notification-provider-resolved-with-explicit-deferrals",
                "postgres-and-mailpit-provider-bindings-resolved-with-explicit-deferrals",
                "all-required-compose-provider-bindings-resolved"
              ]
            }
          }
        },
        "serviceCatalogueDependency": {
          "type": "string",
          "const": "spec/instances/compose-service/service-catalogue.json"
        },
        "evidenceGrade": {
          "$ref": "#/$defs/evidenceGrade"
        },
        "readinessTier": {
          "$ref": "#/$defs/readinessTier"
        },
        "allowedClaims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allowedClaim"
          },
          "uniqueItems": true
        },
        "prohibitedClaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prohibitedClaim"
          },
          "uniqueItems": true
        },
        "providerBindingRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          },
          "uniqueItems": true
        },
        "deferredProviderBindingRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          },
          "uniqueItems": true
        },
        "deferredBoundaryRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          },
          "uniqueItems": true
        },
        "teardown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["childProcesses", "composeResources"],
          "properties": {
            "childProcesses": {
              "type": "string",
              "minLength": 1
            },
            "composeResources": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "const": "runtime-proof"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "runtime-proof-evidence"
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ]
    },
    "ontologyConcepts": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kebab"
      },
      "uniqueItems": true
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kebab"
      },
      "uniqueItems": true
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    },
    "issueId": {
      "type": "string",
      "const": "USF-183"
    },
    "parentIssueId": {
      "type": "string",
      "const": "USF-133"
    },
    "previousIssueId": {
      "type": "string",
      "const": "USF-181"
    },
    "serviceCatalogueDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "authority"],
      "properties": {
        "path": {
          "type": "string",
          "const": "spec/instances/compose-service/service-catalogue.json"
        },
        "authority": {
          "type": "string",
          "const": "semantic-service-catalogue-authority"
        }
      }
    },
    "composeTarget": {
      "type": "string",
      "const": "compose/compose.dev.generated.yaml"
    },
    "runtimeModes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/runtimeModeRecord"
      }
    },
    "providerBindingMatrix": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/providerBinding"
      }
    },
    "providerSdkBoundary": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selectedPackage",
          "selectedVersion",
          "officialOrDefactoStatus",
          "maintenanceEvidence",
          "securityPosture",
          "typescriptSupport",
          "localComposeCompatibility",
          "alternativesRejected",
          "approvedImportBoundary",
          "dependencyPinning"
        ],
        "properties": {
          "selectedPackage": {
            "type": "string",
            "enum": [
              "@keycloak/keycloak-admin-client",
              "@nats-io/transport-node",
              "@temporalio/client",
              "@temporalio/worker",
              "@temporalio/workflow",
              "mailpit-api",
              "minio",
              "node-vault",
              "pg",
              "windmill-client"
            ]
          },
          "selectedVersion": {
            "type": "string",
            "minLength": 1
          },
          "officialOrDefactoStatus": {
            "type": "string",
            "minLength": 1
          },
          "maintenanceEvidence": {
            "type": "string",
            "minLength": 1
          },
          "securityPosture": {
            "type": "string",
            "minLength": 1
          },
          "typescriptSupport": {
            "type": "string",
            "minLength": 1
          },
          "localComposeCompatibility": {
            "type": "string",
            "minLength": 1
          },
          "alternativesRejected": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "approvedImportBoundary": {
            "type": "string",
            "enum": [
              "adapters/bus/src/index.ts",
              "adapters/db/src/index.ts",
              "adapters/idp/src/index.ts",
              "adapters/mail/src/index.ts",
              "adapters/secrets/src/index.ts",
              "adapters/store/src/index.ts",
              "adapters/wf/src/index.ts",
              "packages/proof/src/windmill-configured-proof.ts"
            ]
          },
          "dependencyPinning": {
            "type": "string",
            "const": "exact-version-pinned"
          }
        }
      }
    },
    "proofCommands": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageScript", "makeTarget", "invocation", "mode"],
        "properties": {
          "packageScript": {
            "type": "string",
            "minLength": 1
          },
          "makeTarget": {
            "type": "string",
            "minLength": 1
          },
          "invocation": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": ["validator", "all", "dev-in-memory", "dev-compose-backed"]
          }
        }
      }
    },
    "syntheticDataBoundary": {
      "type": "string",
      "minLength": 1
    },
    "accessBoundary": {
      "type": "string",
      "minLength": 1
    },
    "auditEvidenceBoundary": {
      "type": "string",
      "minLength": 1
    },
    "secretBoundary": {
      "type": "string",
      "minLength": 1
    },
    "tenantBoundary": {
      "type": "string",
      "minLength": 1
    },
    "evidenceGrade": {
      "$ref": "#/$defs/evidenceGrade"
    },
    "readinessTier": {
      "$ref": "#/$defs/readinessTier"
    },
    "allowedClaims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allowedClaim"
      },
      "uniqueItems": true
    },
    "prohibitedClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prohibitedClaim"
      },
      "uniqueItems": true
    },
    "deferredBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "boundary", "claimsProhibitedUntilResolved"],
        "properties": {
          "id": {
            "$ref": "#/$defs/kebab"
          },
          "mode": {
            "$ref": "#/$defs/runtimeMode"
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "followUpIssueRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "claimsProhibitedUntilResolved": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/prohibitedClaim"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "enterpriseEvidenceSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeAssetEvidence",
        "ownerLinkage",
        "auditEventProduction",
        "healthReadinessEvidence",
        "tenantIsolationEvidence",
        "accessControlEvidence",
        "secretBoundaryEvidence",
        "syntheticDataEvidence",
        "operationalTeardownEvidence",
        "incidentResponseEvidenceBoundary",
        "changePromotionEvidenceBoundary",
        "serviceCatalogueTraceability",
        "statementOfApplicabilitySupport"
      ],
      "properties": {
        "runtimeAssetEvidence": {
          "type": "string",
          "minLength": 1
        },
        "ownerLinkage": {
          "type": "string",
          "minLength": 1
        },
        "auditEventProduction": {
          "type": "string",
          "minLength": 1
        },
        "healthReadinessEvidence": {
          "type": "string",
          "minLength": 1
        },
        "tenantIsolationEvidence": {
          "type": "string",
          "minLength": 1
        },
        "accessControlEvidence": {
          "type": "string",
          "minLength": 1
        },
        "secretBoundaryEvidence": {
          "type": "string",
          "minLength": 1
        },
        "syntheticDataEvidence": {
          "type": "string",
          "minLength": 1
        },
        "operationalTeardownEvidence": {
          "type": "string",
          "minLength": 1
        },
        "incidentResponseEvidenceBoundary": {
          "type": "string",
          "minLength": 1
        },
        "changePromotionEvidenceBoundary": {
          "type": "string",
          "minLength": 1
        },
        "serviceCatalogueTraceability": {
          "type": "string",
          "minLength": 1
        },
        "statementOfApplicabilitySupport": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prohibitedClaim"
      },
      "uniqueItems": true
    }
  }
}
