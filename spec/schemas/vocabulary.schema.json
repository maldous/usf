{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:vocabulary",
  "title": "USF Vocabulary Schema",
  "description": "Draft JSON Schema for the USF vocabulary catalogue (spec/vocabularies/vocabulary-catalog.json) and future vocabulary artefacts. Validates value sets and their values: each value set declares a lifecycle status, governed taxonomies and ontology concepts, values, aliases, and forbidden values; each value declares a value-lifecycle (canonical/provisional/alias/deprecated/forbidden/deferred). Aliases carry a canonical target. Grounds the rank-1 semantic-definition corpus via the ontology concepts Semantic Contract (normative allowed values) and Registry (controlled-value index). Cross-record checks (unique value-set/value ids, aliases resolve to canonical, forbidden never canonical) are validator responsibilities deferred per schema-authoring-standard §24. lifecycleState draft; not active.",
  "type": "object",
  "$defs": {
    "kebab": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "valueSetStatus": {
      "$comment": "From the catalogue's valueSetLifecycleStates.",
      "type": "string",
      "enum": ["proposed", "draft", "active", "deprecated", "retired", "deferred"]
    },
    "valueLifecycle": {
      "$comment": "From the catalogue's valueLifecycleStates.",
      "type": "string",
      "enum": ["canonical", "provisional", "alias", "deprecated", "forbidden", "deferred"]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "lifecycle"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "lifecycle": {"$ref": "#/$defs/valueLifecycle"},
        "canonical": {"type": "boolean"},
        "sourceNotes": {"type": "string"},
        "aiGuidance": {"type": "string"},
        "precedence": {"type": "integer"},
        "order": {"type": "integer"},
        "strongerThan": {"type": "array", "items": {"$ref": "#/$defs/kebab"}},
        "weakerThan": {"type": "array", "items": {"$ref": "#/$defs/kebab"}},
        "requiresEvidence": {"type": "boolean"},
        "requiresADR": {"type": "boolean"}
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "canonical": {"$ref": "#/$defs/kebab"},
        "sourceNote": {"type": "string"}
      }
    },
    "valueSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "description", "governedOntologyConcepts", "values"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "title": {"type": "string"},
        "status": {"$ref": "#/$defs/valueSetStatus"},
        "description": {"type": "string"},
        "governedTaxonomies": {"type": "array", "items": {"$ref": "#/$defs/kebab"}},
        "governedOntologyConcepts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expectedSchemaConsumers": {"type": "array", "items": {"type": "string"}},
        "expectedValidatorUse": {"type": "string"},
        "sourceInputs": {"type": "array", "items": {"type": "string"}},
        "values": {"type": "array", "items": {"$ref": "#/$defs/value"}},
        "aliases": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
        "forbiddenValues": {"type": "array", "items": {"type": "object"}},
        "driftRisks": {"type": "array", "items": {"type": "string"}},
        "aiGuidance": {"type": "array", "items": {"type": "string"}},
        "deferredDetails": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "required": ["id", "title", "status", "version", "authorityLevel", "purpose", "valueSets"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": ["string", "null"]},
    "id": {"type": "string", "pattern": "^usf\\.[a-z0-9-]+$"},
    "title": {"type": "string"},
    "status": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authorityLevel": {"type": "string", "enum": ["semantic-definition", "adr", "validator-rule", "runtime-proof-evidence", "source-implementation", "historical-source-evidence", "generated-report"]},
    "purpose": {"type": "string"},
    "createdAfter": {"type": "array", "items": {"type": "string"}},
    "consistentWith": {"type": "array", "items": {"type": "string"}},
    "normativeLanguage": {"type": "string"},
    "scopeNote": {"type": "string"},
    "currentRepositoryState": {"type": "object"},
    "governance": {"type": "object"},
    "vocabularyDesignPrinciples": {"type": "array", "items": {"type": "string"}},
    "vocabularyRules": {"type": "array", "items": {"type": "string"}},
    "valueSetLifecycleStates": {"type": "array", "items": {"type": "object"}},
    "valueLifecycleStates": {"type": "array", "items": {"type": "object"}},
    "valueSets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/valueSet"}},
    "forbiddenValues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token", "rationale"],
        "properties": {
          "token": {"type": "string"},
          "rationale": {"type": "string"},
          "allowedException": {"type": "string"},
          "aiGuidance": {"type": "string"}
        }
      }
    },
    "reactSourceLearnings": {"type": "array"},
    "validationExpectations": {"type": "array", "items": {"type": "string"}},
    "aiAgentRules": {"type": "array", "items": {"type": "string"}},
    "deferredWork": {"type": "array"},
    "acceptanceCriteria": {"type": "array"}
  }
}
