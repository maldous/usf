{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:vocabulary",
  "title": "USF Vocabulary Schema",
  "description": "Draft JSON Schema for the USF vocabulary catalogue (spec/vocabularies/vocabulary-catalog.json) and future vocabulary artefacts. Validates value sets and their values per the catalogue's vocabularyRules: each value set declares status, governed taxonomies and ontology concepts, expected schema consumers, AI guidance, and values; each value declares a value-lifecycle and AI guidance. Per the catalogue's alias convention, aliases live ONLY in each set's aliases array and are not listed in values; therefore values[].lifecycle does NOT permit 'alias'. Active and draft value sets require at least one value; a deferred value set (e.g. capability-domains) may be empty. CLOSURE POLICY: value sets, values, aliases, lifecycle-state definitions, and forbidden-value entries are closed; descriptive blocks (currentRepositoryState, governance, reactSourceLearnings, deferredWork, acceptanceCriteria) are deliberately-open extension points typed permissively in this draft and documented as such. Cross-record checks (unique ids, aliases resolve to canonical, forbidden never canonical) are validator-deferred per schema-authoring-standard section 24. lifecycleState draft; not active.",
  "type": "object",
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "valueSetStatus": {
      "$comment": "From the catalogue's valueSetLifecycleStates.",
      "type": "string",
      "enum": [
        "proposed",
        "draft",
        "active",
        "deprecated",
        "retired",
        "deferred"
      ]
    },
    "valueItemLifecycle": {
      "$comment": "Lifecycle of a values[] entry. 'alias' is intentionally excluded: aliases live only in the set's aliases array per the catalogue alias convention.",
      "type": "string",
      "enum": [
        "canonical",
        "provisional",
        "deprecated",
        "forbidden",
        "deferred"
      ]
    },
    "lifecycleStateDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "allowedUse": {
          "type": "string"
        },
        "validatorExpectation": {
          "type": "string"
        },
        "aiGuidance": {
          "type": "string"
        }
      }
    },
    "forbiddenValueItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "rationale"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "allowedException": {
          "type": "string"
        },
        "aiGuidance": {
          "type": "string"
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "lifecycle",
        "aiGuidance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "$ref": "#/$defs/valueItemLifecycle"
        },
        "canonical": {
          "type": "boolean"
        },
        "sourceNotes": {
          "type": "string"
        },
        "aiGuidance": {
          "type": "string",
          "minLength": 1
        },
        "precedence": {
          "type": "integer"
        },
        "order": {
          "type": "integer"
        },
        "strongerThan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "weakerThan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "requiresEvidence": {
          "type": "boolean"
        },
        "requiresADR": {
          "type": "boolean"
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "canonical": {
          "$ref": "#/$defs/kebab"
        },
        "sourceNote": {
          "type": "string"
        }
      }
    },
    "valueSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "description",
        "governedTaxonomies",
        "governedOntologyConcepts",
        "expectedSchemaConsumers",
        "values",
        "aiGuidance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/valueSetStatus"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "governedTaxonomies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "governedOntologyConcepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expectedSchemaConsumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedValidatorUse": {
          "type": "string"
        },
        "sourceInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "forbiddenValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbiddenValueItem"
          }
        },
        "driftRisks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aiGuidance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deferredDetails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "$comment": "Active and draft value sets must enumerate at least one value; deferred (and proposed) sets may be empty.",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "draft"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "version",
    "authorityLevel",
    "purpose",
    "valueSets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "const": "usf.vocabulary-catalog"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "semantic-definition"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "createdAfter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consistentWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normativeLanguage": {
      "type": "string"
    },
    "scopeNote": {
      "type": "string"
    },
    "currentRepositoryState": {
      "type": "object",
      "$comment": "Descriptive metadata; deliberately permissive in this draft."
    },
    "governance": {
      "type": "object",
      "$comment": "Descriptive metadata; deliberately permissive in this draft."
    },
    "vocabularyDesignPrinciples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vocabularyRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valueSetLifecycleStates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleStateDef"
      }
    },
    "valueLifecycleStates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleStateDef"
      }
    },
    "valueSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/valueSet"
      }
    },
    "forbiddenValues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenValueItem"
      }
    },
    "reactSourceLearnings": {
      "type": "array",
      "$comment": "Descriptive metadata; deliberately permissive in this draft."
    },
    "validationExpectations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aiAgentRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deferredWork": {
      "type": "array",
      "$comment": "Descriptive metadata; deliberately permissive in this draft."
    },
    "acceptanceCriteria": {
      "type": "array",
      "$comment": "Descriptive metadata; deliberately permissive in this draft."
    }
  }
}
