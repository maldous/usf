{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:import-manifest",
  "title": "USF Import Manifest Schema",
  "description": "Draft JSON Schema for controlled import manifests from ../react (rank-6 historical-source-evidence). Each entry pairs a source reference with a source kind (source-kinds), a source role (source-roles), and a mandatory disposition (disposition-values) plus rationale, so no source element disappears without a disposition and source paths never dictate target paths. Governs the ontology concepts Source Reference and Disposition. lifecycleState draft; not active. GOVERNANCE ENVELOPE: instances MUST carry id, title, description, authorityLevel, lifecycleState, ontologyConcepts, taxonomyRefs, vocabularyRefs, and aiGuidance (schema-authoring-standard section 9/11). Envelope fields kind (artefact-kinds) and version are deviated and intentionally not required: this artefact is not a top-level artefact-kind and instance versioning is deferred to instance-topology definition (recorded deviation per schema-authoring-standard section 9.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entries",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance"
  ],
  "$defs": {
    "sourceKind": {
      "type": "string",
      "enum": [
        "source-file",
        "semantic-artefact",
        "documentation",
        "make-target",
        "package-script",
        "environment-variable",
        "configuration-file",
        "configuration-key",
        "compose-service",
        "application",
        "package",
        "module",
        "test",
        "e2e-journey",
        "proof-script",
        "generated-report",
        "readiness-gate",
        "operational-semantic",
        "event-semantic",
        "ui-semantic",
        "data-migration-artefact",
        "observability-audit-artefact"
      ]
    },
    "sourceRole": {
      "type": "string",
      "enum": [
        "semantic-source",
        "behavioural-evidence",
        "proof-evidence",
        "operational-evidence",
        "configuration-evidence",
        "command-evidence",
        "ui-evidence",
        "interface-evidence",
        "event-workflow-evidence",
        "data-evidence",
        "observability-audit-evidence",
        "generated-summary-evidence",
        "historical-lineage"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "preserve",
        "rename",
        "refactor",
        "merge",
        "split",
        "replace",
        "retire",
        "defer",
        "reject"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRef",
        "sourceKind",
        "sourceRole",
        "disposition",
        "rationale"
      ],
      "properties": {
        "sourceRef": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "commit"
                  ]
                },
                {
                  "required": [
                    "tag"
                  ]
                }
              ],
              "$comment": "Inline source reference: at least one non-empty locator (path/commit/tag) is required so the reference is resolvable."
            }
          ]
        },
        "sourceKind": {
          "$ref": "#/$defs/sourceKind"
        },
        "sourceRole": {
          "$ref": "#/$defs/sourceRole"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "targetUsfConcept": {
          "type": "string",
          "$comment": "Source path MUST NOT dictate target path."
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceRepository": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "historical-source-evidence",
      "$comment": "authority-levels canonical value pinned to this schema's registry authorityRole."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ],
      "$comment": "lifecycle-states canonical values."
    },
    "ontologyConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    }
  }
}
