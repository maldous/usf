{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:import-manifest",
  "title": "USF Import Manifest Schema",
  "description": "Draft JSON Schema for controlled import manifests from ../react (rank-6 historical-source-evidence). Each entry pairs a source reference with a source kind (source-kinds), a source role (source-roles), and a mandatory disposition (disposition-values) plus rationale, so no source element disappears without a disposition and source paths never dictate target paths. Governs the ontology concepts Source Reference and Disposition. lifecycleState draft; not active.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entries"],
  "$defs": {
    "sourceKind": {"type": "string", "enum": ["source-file", "semantic-artefact", "documentation", "make-target", "package-script", "environment-variable", "configuration-file", "configuration-key", "compose-service", "application", "package", "module", "test", "e2e-journey", "proof-script", "generated-report", "readiness-gate", "operational-semantic", "event-semantic", "ui-semantic", "data-migration-artefact", "observability-audit-artefact"]},
    "sourceRole": {"type": "string", "enum": ["semantic-source", "behavioural-evidence", "proof-evidence", "operational-evidence", "configuration-evidence", "command-evidence", "ui-evidence", "interface-evidence", "event-workflow-evidence", "data-evidence", "observability-audit-evidence", "generated-summary-evidence", "historical-lineage"]},
    "disposition": {"type": "string", "enum": ["preserve", "rename", "refactor", "merge", "split", "replace", "retire", "defer", "reject"]},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "sourceKind", "sourceRole", "disposition", "rationale"],
      "properties": {
        "sourceRef": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "object", "required": ["repository"], "additionalProperties": false, "properties": {"repository": {"type": "string"}, "path": {"type": "string"}, "commit": {"type": "string"}, "tag": {"type": "string"}}}
          ]
        },
        "sourceKind": {"$ref": "#/$defs/sourceKind"},
        "sourceRole": {"$ref": "#/$defs/sourceRole"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "rationale": {"type": "string", "minLength": 1},
        "targetUsfConcept": {"type": "string", "$comment": "Source path MUST NOT dictate target path."}
      }
    }
  },
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "sourceRepository": {"type": "string"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  }
}
