{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:configuration",
  "title": "USF Configuration Schema",
  "description": "Draft JSON Schema for configuration artefacts (env vars, files, keys, secret-bearing settings, provider/environment/proof/runtime/compose configuration). Each declares its kind (configuration-kinds), secret classification, and provider mode (provider-modes) / environment (environment-classes) / proof relevance. A secret-bearing setting MUST NOT carry its literal value (never leak secrets); generated configuration declares its source manifest (generated config is regenerated, not hand-edited). Governs the ontology concept Configuration. lifecycleState draft; not active. GOVERNANCE ENVELOPE: instances MUST carry id, title, description, authorityLevel, lifecycleState, ontologyConcepts, taxonomyRefs, vocabularyRefs, and aiGuidance (schema-authoring-standard section 9/11). Envelope fields kind (artefact-kinds) and version are deviated and intentionally not required: this artefact is not a top-level artefact-kind and instance versioning is deferred to instance-topology definition (recorded deviation per schema-authoring-standard section 9.3). MODEL NOTE: a configuration carries one primary configurationKind plus dimension flags; secretBearing true is permitted on any kind (e.g. environment-variable) to mark a secret dimension, but the secret-bearing-setting kind requires secretBearing true. A literal value is never serialised for a secret-bearing setting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "configurationKind",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance",
    "purpose",
    "secretBearing"
  ],
  "$defs": {
    "configurationKind": {
      "type": "string",
      "enum": [
        "environment-variable",
        "configuration-file",
        "configuration-key",
        "secret-bearing-setting",
        "non-secret-setting",
        "provider-configuration",
        "environment-configuration",
        "proof-configuration",
        "runtime-configuration",
        "compose-configuration"
      ]
    },
    "providerMode": {
      "type": "string",
      "enum": [
        "hermetic-mock",
        "local-composed-real-service",
        "external-sandbox",
        "live-external-provider"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "hermetic",
        "integration",
        "staging",
        "production-shaped",
        "production-live"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "configurationKind": {
      "$ref": "#/$defs/configurationKind"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "secretBearing": {
      "type": "boolean"
    },
    "value": {
      "type": "string",
      "$comment": "Only permitted for non-secret settings; never the literal value of a secret."
    },
    "providerMode": {
      "$ref": "#/$defs/providerMode"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "proofRelevant": {
      "type": "boolean"
    },
    "generated": {
      "type": "boolean"
    },
    "sourceManifest": {
      "type": "string",
      "minLength": 1
    },
    "reloadOrRestart": {
      "type": "string",
      "enum": [
        "reload",
        "restart"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "semantic-definition",
      "$comment": "authority-levels canonical value pinned to this schema's registry authorityRole."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ],
      "$comment": "lifecycle-states canonical values."
    },
    "ontologyConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "$comment": "Never leak a secret value: a secret-bearing setting MUST NOT carry a literal value.",
      "if": {
        "properties": {
          "configurationKind": {
            "const": "secret-bearing-setting"
          }
        },
        "required": [
          "configurationKind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    {
      "$comment": "If flagged secretBearing, the literal value MUST NOT be present.",
      "if": {
        "properties": {
          "secretBearing": {
            "const": true
          }
        },
        "required": [
          "secretBearing"
        ]
      },
      "then": {
        "not": {
          "required": [
            "value"
          ]
        }
      }
    },
    {
      "$comment": "Generated configuration declares its source manifest (regenerated, not hand-edited).",
      "if": {
        "properties": {
          "generated": {
            "const": true
          }
        },
        "required": [
          "generated"
        ]
      },
      "then": {
        "required": [
          "sourceManifest"
        ]
      }
    },
    {
      "$comment": "provider-configuration declares the provider mode it selects.",
      "if": {
        "properties": {
          "configurationKind": {
            "const": "provider-configuration"
          }
        },
        "required": [
          "configurationKind"
        ]
      },
      "then": {
        "required": [
          "providerMode"
        ]
      }
    },
    {
      "$comment": "environment-configuration declares the environment it scopes to.",
      "if": {
        "properties": {
          "configurationKind": {
            "const": "environment-configuration"
          }
        },
        "required": [
          "configurationKind"
        ]
      },
      "then": {
        "required": [
          "environment"
        ]
      }
    },
    {
      "$comment": "proof-configuration declares proof relevance true.",
      "if": {
        "properties": {
          "configurationKind": {
            "const": "proof-configuration"
          }
        },
        "required": [
          "configurationKind"
        ]
      },
      "then": {
        "required": [
          "proofRelevant"
        ],
        "properties": {
          "proofRelevant": {
            "const": true
          }
        }
      }
    },
    {
      "$comment": "secret-bearing-setting kind must declare secretBearing true (internal consistency).",
      "if": {
        "properties": {
          "configurationKind": {
            "const": "secret-bearing-setting"
          }
        },
        "required": [
          "configurationKind"
        ]
      },
      "then": {
        "properties": {
          "secretBearing": {
            "const": true
          }
        }
      }
    },
    {
      "$comment": "non-secret-setting asserts the opposite of the secret dimension; secretBearing must be false.",
      "if": {
        "properties": {
          "configurationKind": {
            "const": "non-secret-setting"
          }
        },
        "required": [
          "configurationKind"
        ]
      },
      "then": {
        "properties": {
          "secretBearing": {
            "const": false
          }
        }
      }
    }
  ]
}
