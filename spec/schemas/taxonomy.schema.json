{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:taxonomy",
  "title": "USF Taxonomy Schema",
  "description": "Draft JSON Schema for the USF taxonomy catalogue (spec/taxonomies/taxonomy-catalog.json) and future taxonomy artefacts. Validates taxonomy families and taxonomies: each taxonomy belongs to a family, declares a classificationMode from the classification-modes vocabulary, a lifecycle status from lifecycle-states, governed ontology concepts, and categories. Grounds the rank-1 semantic-definition corpus via the ontology concepts Semantic Contract (normative classification structure) and Registry (resolution index). Cross-record checks (unique family/taxonomy ids, every taxonomy in a known family) are validator responsibilities deferred to validator implementation per schema-authoring-standard §24. lifecycleState draft; not active.",
  "type": "object",
  "$defs": {
    "kebab": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "classificationMode": {
      "$comment": "Canonical values from the vocabulary value set 'classification-modes'.",
      "type": "string",
      "enum": ["exclusive", "non-exclusive", "hierarchical", "relational", "dimensional"]
    },
    "lifecycleState": {
      "$comment": "Canonical values from the vocabulary value set 'lifecycle-states'.",
      "type": "string",
      "enum": ["proposed", "planned", "draft", "active", "deprecated", "retired", "replaced", "deferred"]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "taxonomyFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "governedOntologyConcepts", "purpose"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "governedOntologyConcepts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purpose": {"type": "string"},
        "expectedFutureTaxonomies": {"type": "array", "items": {"$ref": "#/$defs/kebab"}},
        "expectedFutureVocabularyDependencies": {"type": "array", "items": {"$ref": "#/$defs/kebab"}},
        "expectedFutureSchemaDependencies": {"type": "array", "items": {"type": "string"}},
        "reactSourceInputs": {"type": "array", "items": {"type": "string"}},
        "aiGuidance": {"type": "string"}
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "family", "status", "classificationMode", "governedOntologyConcepts", "purpose", "categories"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "title": {"type": "string"},
        "family": {"$ref": "#/$defs/kebab"},
        "status": {"$ref": "#/$defs/lifecycleState"},
        "classificationMode": {"$ref": "#/$defs/classificationMode"},
        "governedOntologyConcepts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "purpose": {"type": "string"},
        "categories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/category"}},
        "categoryRules": {"type": "array", "items": {"type": "string"}},
        "futureVocabularyDependencies": {"type": "array", "items": {"$ref": "#/$defs/kebab"}},
        "futureSchemaDependencies": {"type": "array", "items": {"type": "string"}},
        "reactSourceInputs": {"type": "array", "items": {"type": "string"}},
        "validationExpectations": {"type": "array", "items": {"type": "string"}},
        "driftRisks": {"type": "array", "items": {"type": "string"}},
        "aiGuidance": {"type": "string"},
        "deferredDetails": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "required": ["id", "title", "status", "version", "authorityLevel", "purpose", "taxonomyFamilies", "taxonomies"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": ["string", "null"]},
    "id": {"type": "string", "pattern": "^usf\\.[a-z0-9-]+$"},
    "title": {"type": "string"},
    "status": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authorityLevel": {"type": "string", "enum": ["semantic-definition", "adr", "validator-rule", "runtime-proof-evidence", "source-implementation", "historical-source-evidence", "generated-report"]},
    "purpose": {"type": "string"},
    "createdAfter": {"type": "array", "items": {"type": "string"}},
    "consistentWith": {"type": "array", "items": {"type": "string"}},
    "normativeLanguage": {"type": "string"},
    "scopeNote": {"type": "string"},
    "currentRepositoryState": {"type": "object"},
    "governance": {"type": "object"},
    "taxonomyDesignPrinciples": {"type": "array", "items": {"type": "string"}},
    "taxonomyRules": {"type": "array", "items": {"type": "string"}},
    "taxonomyFamilies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taxonomyFamily"}},
    "taxonomies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taxonomy"}},
    "taxonomyRelationships": {"type": "array"},
    "vocabularyDependencies": {"type": "object"},
    "reactSourceLearnings": {"type": "array"},
    "externalStandardsInfluence": {"type": "array"},
    "validationExpectations": {"type": "array", "items": {"type": "string"}},
    "aiAgentRules": {"type": "array", "items": {"type": "string"}},
    "deferredWork": {"type": "array"},
    "acceptanceCriteria": {"type": "array"}
  }
}
