{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:interface-contract",
  "title": "USF Interface Contract Schema",
  "description": "Draft JSON Schema for interface contracts (API routes, commands, queries, event handlers, service boundaries, CLI interfaces, provider ports, adapter interfaces, internal/external contracts). Each declares its kind (interface-kinds), purpose, boundary, a reference to the governing semantic contract, and at least one input/output (request/response) contract. Interfaces are contract-first or contract-reconciled and MUST NOT be inferred from handlers when a contract exists. USF claims no full OpenAPI compliance until concrete OpenAPI artefacts exist. Governs the ontology concepts Interface, Service, and Port. The four contract-body objects are CLOSED, typed shapes that must define at least one of schemaRef, fields, description, or a typed extensions map (no empty contract body). GOVERNANCE ENVELOPE: instances MUST carry id, title, description, authorityLevel, lifecycleState, ontologyConcepts, taxonomyRefs, vocabularyRefs, and aiGuidance (schema-authoring-standard section 9/11); kind (artefact-kinds) and version are deviated/deferred (recorded per section 9.3). lifecycleState draft; not active.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance",
    "interfaceKind",
    "purpose",
    "boundary",
    "semanticContractRef"
  ],
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "interfaceKind": {
      "type": "string",
      "enum": [
        "api-route",
        "command",
        "query",
        "event-handler",
        "service-boundary",
        "cli-interface",
        "provider-port",
        "adapter-interface",
        "internal-contract",
        "external-contract"
      ]
    },
    "contractBody": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Closed, typed contract body. At least one of schemaRef, non-empty fields, non-empty description, or a non-empty typed extensions map must be present, so an empty contract body is rejected.",
      "anyOf": [
        {
          "required": [
            "schemaRef"
          ]
        },
        {
          "required": [
            "fields"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "extensions"
          ]
        }
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extensions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "semantic-definition",
      "$comment": "authority-levels value pinned to the registry authorityRole."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ]
    },
    "ontologyConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kebab"
      }
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kebab"
      }
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    },
    "interfaceKind": {
      "$ref": "#/$defs/interfaceKind"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "string",
      "minLength": 1
    },
    "inputContract": {
      "$ref": "#/$defs/contractBody"
    },
    "outputContract": {
      "$ref": "#/$defs/contractBody"
    },
    "requestContract": {
      "$ref": "#/$defs/contractBody"
    },
    "responseContract": {
      "$ref": "#/$defs/contractBody"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security": {
      "type": "string"
    },
    "semanticContractRef": {
      "type": "string",
      "minLength": 1
    },
    "driftDetectable": {
      "type": "boolean"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "anyOf": [
    {
      "$comment": "At least one input/output (request/response) contract must be present, matching the description.",
      "required": [
        "inputContract"
      ]
    },
    {
      "required": [
        "outputContract"
      ]
    },
    {
      "required": [
        "requestContract"
      ]
    },
    {
      "required": [
        "responseContract"
      ]
    }
  ]
}
