{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:schema:proof-evidence",
  "title": "USF Proof Evidence Schema",
  "description": "Draft JSON Schema for proof evidence records (rank-4 runtime-proof-evidence). Enforces honest proof: a claimed proof level (proof-levels) that does not exceed the observed level, mandatory provider mode (provider-modes) and environment (environment-classes), preserved emitted AND collected evidence (both non-empty above discovery), and that a live-external-provider claim requires both providerMode live-external-provider and an observed level at the substrate floor or above. Governs the ontology concepts Proof, Proof Level, and Evidence. GOVERNANCE ENVELOPE: instances MUST carry id, title, description, authorityLevel, lifecycleState, ontologyConcepts, taxonomyRefs, vocabularyRefs, and aiGuidance (schema-authoring-standard section 9/11); the artefact-kinds kind here is the proof kind, and version is deviated/deferred (recorded per section 9.3). lifecycleState draft; not active.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "description",
    "authorityLevel",
    "lifecycleState",
    "ontologyConcepts",
    "taxonomyRefs",
    "vocabularyRefs",
    "aiGuidance",
    "proofLevelClaimed",
    "proofLevelObserved",
    "providerMode",
    "environment",
    "emittedEvidence",
    "collectedEvidence"
  ],
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "proofLevel": {
      "type": "string",
      "enum": [
        "discovery-proven",
        "executable-proven",
        "contract-proven",
        "behaviour-proven",
        "substrate-proven",
        "resilience-proven",
        "foundation-proven"
      ]
    },
    "providerMode": {
      "type": "string",
      "enum": [
        "hermetic-mock",
        "local-composed-real-service",
        "external-sandbox",
        "live-external-provider"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "hermetic",
        "integration",
        "staging",
        "production-shaped",
        "production-live"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "const": "proof",
      "$comment": "artefact-kinds value 'proof'."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "authorityLevel": {
      "type": "string",
      "const": "runtime-proof-evidence",
      "$comment": "authority-levels value pinned to the registry authorityRole."
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "draft",
        "active",
        "deprecated",
        "retired",
        "replaced",
        "deferred"
      ]
    },
    "ontologyConcepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taxonomyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kebab"
      }
    },
    "vocabularyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kebab"
      }
    },
    "aiGuidance": {
      "type": "string",
      "minLength": 1
    },
    "claimExercised": {
      "type": "string",
      "minLength": 1
    },
    "proofLevelClaimed": {
      "$ref": "#/$defs/proofLevel"
    },
    "proofLevelObserved": {
      "$ref": "#/$defs/proofLevel"
    },
    "providerMode": {
      "$ref": "#/$defs/providerMode"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "liveExternalProviderClaim": {
      "type": "boolean",
      "default": false
    },
    "emittedEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "$comment": "May be empty only at discovery level; the allOf ladder requires non-empty above discovery."
    },
    "collectedEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "$comment": "May be empty only at discovery level; the allOf ladder requires non-empty above discovery."
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "failureSemantics": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "$comment": "claimed <= observed (proof-levels order), one if/then per observed level.",
      "if": {
        "properties": {
          "proofLevelObserved": {
            "const": "discovery-proven"
          }
        },
        "required": [
          "proofLevelObserved"
        ]
      },
      "then": {
        "properties": {
          "proofLevelClaimed": {
            "enum": [
              "discovery-proven"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proofLevelObserved": {
            "const": "executable-proven"
          }
        },
        "required": [
          "proofLevelObserved"
        ]
      },
      "then": {
        "properties": {
          "proofLevelClaimed": {
            "enum": [
              "discovery-proven",
              "executable-proven"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proofLevelObserved": {
            "const": "contract-proven"
          }
        },
        "required": [
          "proofLevelObserved"
        ]
      },
      "then": {
        "properties": {
          "proofLevelClaimed": {
            "enum": [
              "discovery-proven",
              "executable-proven",
              "contract-proven"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proofLevelObserved": {
            "const": "behaviour-proven"
          }
        },
        "required": [
          "proofLevelObserved"
        ]
      },
      "then": {
        "properties": {
          "proofLevelClaimed": {
            "enum": [
              "discovery-proven",
              "executable-proven",
              "contract-proven",
              "behaviour-proven"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proofLevelObserved": {
            "const": "substrate-proven"
          }
        },
        "required": [
          "proofLevelObserved"
        ]
      },
      "then": {
        "properties": {
          "proofLevelClaimed": {
            "enum": [
              "discovery-proven",
              "executable-proven",
              "contract-proven",
              "behaviour-proven",
              "substrate-proven"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proofLevelObserved": {
            "const": "resilience-proven"
          }
        },
        "required": [
          "proofLevelObserved"
        ]
      },
      "then": {
        "properties": {
          "proofLevelClaimed": {
            "enum": [
              "discovery-proven",
              "executable-proven",
              "contract-proven",
              "behaviour-proven",
              "substrate-proven",
              "resilience-proven"
            ]
          }
        }
      }
    },
    {
      "$comment": "Fail closed above discovery: both emitted and collected evidence must be non-empty.",
      "if": {
        "not": {
          "properties": {
            "proofLevelObserved": {
              "const": "discovery-proven"
            }
          }
        }
      },
      "then": {
        "properties": {
          "emittedEvidence": {
            "minItems": 1
          },
          "collectedEvidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "$comment": "hermetic-mock MUST NOT satisfy a live-external-provider claim (Charter section 6).",
      "if": {
        "properties": {
          "providerMode": {
            "const": "hermetic-mock"
          }
        },
        "required": [
          "providerMode"
        ]
      },
      "then": {
        "properties": {
          "liveExternalProviderClaim": {
            "const": false
          }
        }
      }
    },
    {
      "$comment": "A live-external-provider claim requires providerMode live-external-provider AND observed level at the substrate floor or above.",
      "if": {
        "properties": {
          "liveExternalProviderClaim": {
            "const": true
          }
        },
        "required": [
          "liveExternalProviderClaim"
        ]
      },
      "then": {
        "properties": {
          "providerMode": {
            "const": "live-external-provider"
          },
          "proofLevelObserved": {
            "enum": [
              "substrate-proven",
              "resilience-proven",
              "foundation-proven"
            ]
          }
        }
      }
    }
  ]
}
