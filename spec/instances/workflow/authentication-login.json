{
  "id": "workflow.authentication-login",
  "workflowKind": "workflow",
  "title": "Authentication Login Workflow",
  "description": "Draft workflow semantic instance linking the login interface, audit event, provider posture, and UI journey. The first workflow assurance slice requires normal transitions, denied transitions, illegal transition rejection, missing audit failure, and stale or missing proof evidence failure to be explicit.",
  "authorityLevel": "semantic-definition",
  "lifecycleState": "draft",
  "ontologyConcepts": [
    "Workflow",
    "Event"
  ],
  "taxonomyRefs": [
    "event-workflow-classification"
  ],
  "vocabularyRefs": [
    "event-workflow-kinds"
  ],
  "aiGuidance": "Preserve ordering, failure, and compensation semantics during implementation extraction; source proof does not replace this contract.",
  "participants": [
    "interface.authentication-login-api",
    "provider-mode.mock-identity-provider",
    "audit.authentication-login"
  ],
  "ordering": "request validation, provider authentication, illegal transition rejection, audit recording, proof-evidence correlation, response emission",
  "steps": [
    {
      "id": "receive-login-request",
      "description": "Receive and validate the login request at the authentication interface, including provider selection and callback state binding.",
      "operation": "interface.authentication-login-api"
    },
    {
      "id": "evaluate-provider-response",
      "description": "Evaluate the configured identity provider response without upgrading provider mode; denied and provider-error outcomes remain explicit states.",
      "operation": "provider-mode.mock-identity-provider"
    },
    {
      "id": "reject-illegal-transition",
      "description": "Reject session creation, authenticated response emission, or proof success when request validation, provider decision, or tenant identity state is missing or contradictory.",
      "operation": "workflow.authentication-login"
    },
    {
      "id": "record-audit",
      "description": "Record the login audit event before claiming proof success.",
      "operation": "audit.authentication-login"
    }
  ],
  "stateTransitions": [
    {
      "from": "unauthenticated",
      "to": "authenticating",
      "trigger": "login-request-validated"
    },
    {
      "from": "authenticating",
      "to": "authenticated",
      "trigger": "provider-decision-accepted-and-session-created"
    },
    {
      "from": "authenticating",
      "to": "denied",
      "trigger": "provider-decision-denied-or-validation-failed"
    },
    {
      "from": "authenticating",
      "to": "denied",
      "trigger": "illegal-transition-or-missing-required-state"
    },
    {
      "from": "authenticated",
      "to": "unauthenticated",
      "trigger": "logout-or-session-destroyed"
    }
  ],
  "failurePaths": [
    "denied-login-emits-explicit-denied-state-without-session",
    "provider-unavailable-fails-closed",
    "illegal-session-creation-transition-fails-closed",
    "audit-recording-missing-fails-proof-claim",
    "proof-evidence-missing-or-stale-fails-workflow-readiness",
    "stale-proof-must-not-satisfy-current-readiness",
    "readiness-failure-must-not-upgrade-provider-mode"
  ],
  "compensationPaths": [
    "no-compensating-action-for-denied-login; preserve audit record",
    "no-compensating-action-for-illegal-transition; deny and preserve audit/evidence failure"
  ],
  "relatedEvents": [
    "event.authentication-login-audit"
  ],
  "relatedInterfaces": [
    "interface.authentication-login-api"
  ],
  "sourceRefs": [
    "apps/platform-api/scripts/auth-settings-runtime-proof.ts",
    "apps/platform-api/src/server/auth.ts",
    "apps/platform-api/src/server/session.ts",
    "apps/platform-api/src/usecases/auth.ts",
    "apps/platform-api/tests/substrate/auth-routes.test.ts",
    "apps/platform-api/tests/unit/auth-settings-audit.test.ts",
    "docs/evidence/identity/keycloak-login-callback.md",
    "e2e/external/auth-negative.spec.ts",
    "e2e/identity/broker-login.spec.ts"
  ]
}
