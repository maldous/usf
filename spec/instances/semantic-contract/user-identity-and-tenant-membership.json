      ]
    },
    "errorModel": {
      "status": "complete",
      "description": "Absent session, absent membership, other-tenant membership, or unresolved external identity must fail closed as unauthenticated or forbidden context. A tenant-scoped actor must not read or write another tenant's membership, tenant resource configuration, user projection, or external identity linkage.",
