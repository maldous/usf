  "cacheAgeClassificationDecision": {
    "status": "accepted-as-provider-metadata",
    "rationale": "Netlify documentation states Functions are dynamic and not cached by default unless cache headers opt in. Public evidence for these routes shows no-store, Cloudflare DYNAMIC, and Netlify Durable fwd=bypass plus Edge fwd=miss. The Netlify Cache-Status documentation distinguishes Hit from Miss; PR #240 therefore treats low Age with miss/bypass as provider metadata, not cache-hit evidence.",
    "acceptedOnlyWhen": [
      "Cache-Control includes no-store",
      "Cache-Status has no hit directive",
      "Cache-Status has no stale directive",
      "provider evidence includes miss, bypass, or dynamic",
      "provider headers remain evidence only"
    ],
    "stillBlockingWhen": [
      "hit observed",
      "stale observed",
      "missing no-store",
      "cacheable route policy",
      "unknown provider status with Age",
      "provider-specific semantic requirement"
    ]
  }
