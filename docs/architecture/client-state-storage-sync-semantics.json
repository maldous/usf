      "requirement": "Reject sync behaviour semantics that lack capability eligibility, queue entry mapping, retry policy, conflict policy, audit mapping, or privacy mapping."
    },
    {
      "id": "validate-revalidation-trigger-mapping",
      "issueId": "USF-531",
      "validatorType": "future-semantic-validator",
