    },
    {
      "id": "validate-background-refresh-constraint-semantics",
      "issueId": "USF-534",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject background refresh semantics that lack capability, platform, privacy, battery, audit, or unsupported-platform fail-closed mapping."
    },
    {
      "id": "validate-client-device-browser-retention",
      "issueId": "USF-535",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject retained client data semantics without privacy category, retention rule, purge trigger, cache mapping, and proof mapping."
    },
    {
      "id": "validate-logout-session-expiry-purge",
      "issueId": "USF-536",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject logout or session-expiry semantics without purge, token removal, cache clearing, audit, privacy, and fail-closed mapping."
    },
    {
      "id": "validate-privacy-mode-shared-device-posture",
      "issueId": "USF-537",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject privacy-mode or shared-device semantics without posture, storage-limit, session-handling, purge, privacy, and proof mapping."
    }
  ],
