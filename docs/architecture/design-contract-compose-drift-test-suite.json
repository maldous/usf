  "driftChecks": [
    {
      "id": "generated-compose-derivation",
      "description": "Generated test Compose must retain the generator banner, service-catalogue source reference, expected generated service count, expected profile count, and service IDs referenced by the integration matrix.",
      "findingCode": "stale-generated-output"
    },
    {
      "id": "semantic-contract-mapping",
      "description": "Each USF-246 semantic contract row must use the canonical design-contract-drift obligation class and match the contract instance path, id, capability, domain, and facet inventory.",
      "findingCode": "missing-contract-mapping"
    },
    {
      "id": "api-event-provider-binding-mapping",
      "description": "API, event, and provider-binding semantic contract rows must remain represented in the USF-246 semantic obligation set.",
      "findingCode": "api-event-provider-binding-drift"
    },
    {
      "id": "command-surface-wiring",
      "description": "Every canonical test-readiness command must remain present in the command surface, package scripts, and Makefile targets.",
      "findingCode": "missing-command"
    },
    {
      "id": "readiness-non-claim-boundary",
      "description": "Design, command, integration, and generated Compose evidence must not allow final test readiness, staging, production, deployment, live-provider, SOC, ISO, enterprise production, product UI, browser E2E, or full React product parity claims.",
      "findingCode": "readiness-overclaim"
    }
  ],
  "plantedDefectCases": [
    {
      "id": "missing-compose-target",
      "expectedFindingCode": "missing-compose-target"
    },
    {
      "id": "missing-command",
      "expectedFindingCode": "missing-command"
    },
    {
      "id": "missing-contract-mapping",
