    },
    {
      "id": "readiness-overclaim",
      "expectedFindingCode": "readiness-overclaim"
    }
  ],
  "generatedComposeAuthorityBoundary": "Generated Compose is checked as derivative output and never as semantic authority.",
  "serviceBackedClaimRequiresComposedService": true,
  "inMemoryServiceSubstituteAllowedForServiceBackedClaims": false,
  "testReadinessClaimAllowed": false,
  "validationCommands": [
    "corepack pnpm test -- tests/packages/design-contract-compose-drift.test.ts",
