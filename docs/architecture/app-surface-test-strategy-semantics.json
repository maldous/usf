  "semanticModels": [
    {
      "issueId": "USF-831",
      "modelId": "unit-component-test-strategy",
      "purpose": "Define how unit and component tests must tie assertions to governed semantic contracts, generated clients, view-model semantics, accessibility semantics, validator expectations, and proof evidence.",
      "requiredMappings": [
        "semantic-contract-reference",
        "generated-client-reference",
        "view-model-reference",
        "accessibility-reference",
        "validator-reference",
        "proof-evidence-reference",
        "non-claim-reference"
      ],
      "forbiddenInterpretations": [
        "passing tests alone define intended behaviour",
        "framework setup equals test readiness",
        "component tests imply product UI readiness"
      ]
    },
    {
      "issueId": "USF-832",
      "modelId": "generated-client-contract-test-strategy",
      "purpose": "Define how generated client contract tests must map commands, queries, typed errors, validation, authorization, audit events, validators, proof, and non-claims to USF semantic authority.",
      "requiredMappings": [
        "command-contract-reference",
        "query-contract-reference",
        "typed-error-reference",
        "validation-reference",
        "authorization-reference",
        "audit-event-reference",
        "validator-reference",
        "proof-evidence-reference",
        "non-claim-reference"
      ],
      "forbiddenInterpretations": [
        "generated client implementation exists",
        "SDK readiness is claimed",
        "live-provider readiness is claimed"
      ]
    },
    {
      "issueId": "USF-837",
      "modelId": "accessibility-test-strategy",
      "purpose": "Define how accessibility tests must bind screen reader, focus, contrast, keyboard, mobile accessibility, evidence, validators, and proof expectations to accessibility semantics.",
      "requiredMappings": [
        "screen-reader-reference",
        "focus-order-reference",
        "contrast-reference",
        "keyboard-reference",
        "touch-gesture-reference",
        "dynamic-type-reference",
        "reduced-motion-reference",
        "error-announcement-reference",
        "media-alternative-reference",
        "proof-evidence-reference",
        "non-claim-reference"
      ],
      "forbiddenInterpretations": [
        "accessibility certification is claimed",
        "audit execution has occurred",
        "product UI readiness is claimed"
      ]
    },
    {
      "issueId": "USF-849",
      "modelId": "validator-selftest-planted-defect-strategy",
      "purpose": "Define validator selftest and planted-defect requirements proving future app-surface validators reject missing, stale, ambiguous, or overclaimed semantic evidence.",
      "requiredMappings": [
        "validator-rule-reference",
        "planted-defect-reference",
        "negative-case-reference",
        "stale-evidence-reference",
        "missing-evidence-reference",
        "proof-evidence-reference",
        "non-claim-reference"
      ],
      "forbiddenInterpretations": [
        "validator implementation is complete",
        "selftests have been implemented",
        "validator completion is claimed"
      ]
    }
  ],
  "validatorRequirements": [
    {
      "issueId": "USF-831",
      "requirementId": "validator.app-surface.unit-component-tests.semantic-binding",
      "failClosedOn": [
        "test without semantic authority reference",
        "test without generated-client or view-model mapping where applicable",
        "test without accessibility mapping where applicable",
        "generated report treated as canonical evidence"
      ]
    },
    {
      "issueId": "USF-832",
      "requirementId": "validator.app-surface.generated-client-contract-tests.semantic-binding",
      "failClosedOn": [
        "contract test without command or query authority reference",
        "typed error not mapped",
        "authorization expectation missing",
        "audit event expectation missing",
        "SDK readiness claim without proof evidence"
      ]
    },
    {
      "issueId": "USF-837",
      "requirementId": "validator.app-surface.accessibility-tests.semantic-binding",
      "failClosedOn": [
        "accessibility test without accessibility semantic reference",
        "proof evidence missing",
        "proof evidence stale",
        "accessibility certification claim without authority"
      ]
    },
    {
      "issueId": "USF-849",
      "requirementId": "validator.app-surface.selftests.planted-defects",
      "failClosedOn": [
        "missing planted-defect coverage",
        "negative case omitted",
        "stale evidence accepted",
        "unknown evidence status accepted",
        "generated report accepted without raw evidence"
      ]
    }
  ],
