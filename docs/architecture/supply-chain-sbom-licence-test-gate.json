    {
      "id": "package-manager-and-lockfile",
      "categoryId": "supply-chain-sbom-licence",
      "scope": "package manager pin, toolchain engine pin, .npmrc posture, lockfile version, direct dependency lockfile root importer alignment, frozen install posture",
      "evidenceRefs": [
        "package.json",
        ".npmrc",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ],
      "testAssertion": "The issue-local Vitest suite fails on floating direct dependency specifiers, missing package-manager/toolchain posture, missing lockfile root importer entries, lockfile specifier drift, or override drift."
    },
    {
      "id": "dependency-ownership-and-sdk-governance",
      "categoryId": "supply-chain-sbom-licence",
      "scope": "direct dependency owner rules and SDK governance linkage to enterprise evidence rows",
      "evidenceRefs": [
        "package.json",
        "spec/instances/enterprise-evidence/repository-enterprise-evidence-model.json"
      ],
      "testAssertion": "The issue-local Vitest suite fails when a direct dependency lacks a local owner rule or a provider SDK dependency lacks licence, advisory, or update owner posture in enterprise evidence."
    },
    {
      "id": "workspace-package-boundary",
      "categoryId": "supply-chain-sbom-licence",
      "scope": "workspace package globs and centralised external dependency ownership",
      "evidenceRefs": [
        "pnpm-workspace.yaml",
        "apps/*/package.json",
        "capabilities/*/package.json",
        "adapters/*/package.json",
        "packages/*/package.json"
      ],
      "testAssertion": "The issue-local Vitest suite fails if a workspace package sits outside the workspace globs, drops the foundation package prefix, becomes public, changes version unexpectedly, or declares local external dependencies."
    },
    {
      "id": "licence-advisory-sbom-provenance",
      "categoryId": "supply-chain-sbom-licence",
      "scope": "licence inventory posture, advisory posture, SBOM boundary, and release/container provenance and signing boundary",
      "evidenceRefs": [
        "docs/architecture/dev-readiness-validation-and-handover.json",
        "docs/architecture/test-readiness-command-surface-and-ci-gate.json"
      ],
      "testAssertion": "The issue-local Vitest suite fails on missing licence posture, missing advisory posture, missing SBOM generated-or-deferred evidence, missing provenance or signing boundary, or unsupported readiness overclaim."
    },
    {
      "id": "compose-image-pinning-and-provenance",
      "categoryId": "supply-chain-sbom-licence",
      "scope": "Compose image inventory, digest-pinned subset, moving tag blockers, missing generated Compose image blockers, and deferred non-digest provenance",
      "evidenceRefs": [
        "spec/instances/compose-service/service-catalogue.json",
        "compose/compose.test.generated.yaml"
      ],
      "testAssertion": "The issue-local Vitest suite fails when image-bearing service rows lack owners, generated Compose image coverage differs from the documented blocker list, moving tags are not recorded as blockers, or non-digest provenance is overclaimed."
    }
  ],
