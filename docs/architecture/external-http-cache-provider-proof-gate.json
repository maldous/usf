    "purgeBoundary": "No purge or invalidation operation is required for proof/control routes when dynamic no-store responses show miss, bypass, or dynamic provider evidence and no hit or stale directive; future cacheable route classes require separate staging-specific evidence.",
    "staleIfErrorAssessed": true,
    "staleWhileRevalidateAssessed": true,
    "staleDirectiveAllowedForProofRoutes": false,
