  ],
  "sourceFreshnessAnchor": {
    "field": "sourceTreeHash",
    "algorithm": "sha256-git-ls-tree-non-proof-evidence-v1",
    "excludedPrefixes": [
      "artifacts/proof-cockpit/",
      "evidence/proof-evidence/proof-cockpit/"
    ],
    "reason": "Proof-cockpit evidence freshness must survive squash merges and rebases without relying on pre-squash branch commit reachability. sourceSha remains provenance, but sourceTreeHash is the freshness authority for rule USF-PROOF-COCKPIT-009."
  },
  "redactionRules": [
    "fail closed on private key material",
    "fail closed on bearer tokens",
    "fail closed on raw passwords",
    "fail closed on provider API tokens",
    "fail closed on real tenant data markers",
    "mark synthetic data explicitly",
    "record redaction status per evidence item"
  ],
