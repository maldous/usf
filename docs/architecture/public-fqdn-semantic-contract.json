{
  "id": "public-fqdn-semantic-contract",
  "title": "Public FQDN Semantic Contract",
  "issueId": "USF-262",
  "parentIssueId": "USF-261",
  "lifecycleState": "active-public-fqdn-semantic-contract",
  "authorityLevel": "semantic-definition",
  "purpose": "Define the gateway-neutral public HTTP and HTTPS edge semantics required before the later proof tag authorisation gate can be considered. This contract defines future staging and production FQDN requirements without proving delivery and without making the Test environment depend on public internet.",
  "semanticAuthority": {
    "primary": "docs/architecture/public-fqdn-semantic-contract.json",
    "humanReadable": "docs/architecture/public-fqdn-semantic-contract.md",
    "generatedComposeAuthority": false,
    "generatedGatewayConfigAuthority": false,
    "historicalReactAuthority": false,
    "linearAuthority": false
  },
  "dependsOn": {
    "devReadinessIssueId": "USF-226",
    "testReadinessIssueId": "USF-234",
    "testReadinessRepairPr": "https://github.com/maldous/usf/pull/234",
    "testReadinessRepairMergeSha": "c481f867ce2c458cf3800b6d1baccf0d87e5072e"
  },
  "environments": [
    {
      "id": "public-fqdn-staging",
      "environment": "staging",
      "domain": "1e100.network",
      "minimumMandatoryScope": "root-fqdn",
      "requiredHostnames": [
        {
          "id": "staging-root",
          "fqdn": "1e100.network",
          "hostnameType": "root",
          "purpose": "Future staging public edge root FQDN proof boundary.",
          "protocols": [
            "dns",
            "https"
          ],
          "proofCommandId": "proof:public-fqdn:staging",
          "owner": "platform",
          "riskOwner": "platform",
          "controlOwner": "platform",
          "jsonProofEndpointId": "public-edge-json-proof",
          "routeBindingId": "public-route-telemetry-proof-route",
          "telemetryBootstrapId": "public-route-telemetry-bootstrap",
          "claimBoundary": "Defines the future staging public FQDN contract only. It does not claim staging readiness."
        }
      ],
      "additionalHostnames": [],
      "additionalHostnamePolicy": "Additional hostnames such as www, app, api, auth, telemetry, or health are not required until explicitly declared with environment, purpose, protocol, proof command, owner, risk owner, control owner, and a hostname that is either 1e100.network or a subdomain of 1e100.network."
    },
    {
      "id": "public-fqdn-production",
      "environment": "production",
      "domain": "aldous.info",
      "minimumMandatoryScope": "root-fqdn",
      "requiredHostnames": [
        {
          "id": "production-root",
          "fqdn": "aldous.info",
          "hostnameType": "root",
          "purpose": "Future production public edge root FQDN proof boundary.",
          "protocols": [
            "dns",
            "https"
          ],
          "proofCommandId": "proof:public-fqdn:production",
          "owner": "platform",
          "riskOwner": "platform",
          "controlOwner": "platform",
          "jsonProofEndpointId": "public-edge-json-proof",
          "routeBindingId": "public-route-telemetry-proof-route",
          "telemetryBootstrapId": "public-route-telemetry-bootstrap",
          "claimBoundary": "Defines the future production public FQDN contract only. It does not claim production readiness."
        }
      ],
      "additionalHostnames": [],
      "additionalHostnamePolicy": "Additional hostnames such as www, app, api, auth, telemetry, or health are not required until explicitly declared with environment, purpose, protocol, proof command, owner, risk owner, control owner, and a hostname that is either aldous.info or a subdomain of aldous.info."
    }
  ],
  "dnsResolutionSemantics": {
    "required": true,
    "publicResolutionRequired": true,
    "privateOnlyResolutionAllowed": false,
    "acceptedRecordTypes": [
      "A",
      "AAAA",
      "CNAME"
    ],
    "nxdomainAllowed": false,
    "proofIssueId": "USF-263",
    "proofBoundary": "DNS proof is required later by USF-263; this contract defines the expected semantics only."
  },
  "tlsHttpsSemantics": {
    "httpsRequired": true,
    "httpOnlyAllowed": false,
    "validCertificateRequired": true,
    "certificateHostCoverageRequired": true,
    "mixedContentAllowed": false,
    "proofIssueId": "USF-263",
    "proofBoundary": "TLS and HTTPS proof is required later by USF-263; this contract defines the expected semantics only."
  },
  "publicHttpEdgeCapability": {
    "required": true,
    "gatewayNeutral": true,
    "requiredGateway": "none",
    "allowedImplementationEvidenceSources": [
      "cloudflare-observed-configuration",
      "external-gateway-observed-configuration",
      "historical-react-lineage"
    ],
    "prohibitedRequiredGateways": [
      "caddy"
    ],
    "caddyNonRequirement": true,
    "generatedComposeAuthority": false,
    "generatedGatewayConfigAuthority": false,
    "semanticRequirement": "Public HTTP and HTTPS edge capability for declared FQDNs. No gateway product is semantically required."
  },
  "cloudflareBoundary": {
    "declaredProvider": "cloudflare",
    "boundaryType": "dns-and-edge-hosting-provider-boundary",
    "apiSecretRequiredForSemanticContract": false,
    "apiSecretRequiredForBasicProof": false,
    "liveProviderReadinessClaimAllowed": false,
    "supplierBoundary": "Cloudflare is the declared DNS and edge hosting provider boundary according to the human operator. This is provider-boundary evidence organization, not live-provider readiness."
  },
  "publicJsonProofEndpoint": {
    "id": "public-edge-json-proof",
    "required": true,
    "route": "/.well-known/usf-public-edge.json",
    "routeClass": "non-product-json-proof-endpoint",
    "productUiReadinessClaimAllowed": false,
    "browserE2eReadinessClaimAllowed": false,
    "expectedMarker": "usf-public-edge",
    "expectedContentType": "application/json",
    "proofIssueId": "USF-263"
  },
  "publicRouteBinding": {
    "id": "public-route-telemetry-proof-route",
    "required": true,
    "route": "/__proof/public-route",
    "canonicalRoute": "/__proof/public-route",
    "acceptedRouteVariants": [
      "/__proof/public-route",
      "/__proof/public-route/"
    ],
    "trailingSlashPolicy": "The route without a trailing slash is the canonical semantic route. A same-host HTTPS final URL with a trailing slash is accepted only as provider/origin canonicalisation evidence for this non-product proof route. Cross-host redirects, localhost/private redirects, HTTP-only delivery, or a different path are not accepted.",
    "crossHostRedirectAllowed": false,
    "httpOnlyVariantAllowed": false,
    "routeClass": "non-product-browser-telemetry-proof-route",
    "productUiReadinessClaimAllowed": false,
    "browserE2eReadinessClaimAllowed": false,
    "expectedMarker": "usf-public-route",
    "expectedContentType": "text/html",
    "telemetryBootstrapId": "public-route-telemetry-bootstrap",
    "proofIssueId": "USF-264"
  },
  "publicTelemetryBootstrap": {
    "id": "public-route-telemetry-bootstrap",
    "requiredForPublicRouteProof": true,
    "telemetrySystems": [
      "faro",
      "sentry"
    ],
    "observableEvidence": [
      "bootstrap-script-presence",
      "safe-config-marker",
      "bounded-network-observation"
    ],
    "rawTelemetryPayloadRetentionAllowed": false,
    "productUiReadinessClaimAllowed": false,
    "browserE2eReadinessClaimAllowed": false,
    "proofIssueId": "USF-264",
    "proofBoundary": "USF-264 must prove only public route delivery and telemetry bootstrap. It must not prove product UI readiness or browser E2E readiness."
  },
  "testEnvironmentBoundary": {
    "testEnvironmentPublicInternetDependencyAllowed": false,
    "testEnvironmentPublicDnsDependencyAllowed": false,
    "testEnvironmentPublicTlsDependencyAllowed": false,
    "testEnvironmentRemainsLocalComposedSynthetic": true,
    "rationale": "The Test environment remains local, composed, and synthetic. Public FQDN semantics are post-Test and pre-Staging proof gates."
  },
  "validator": {
    "command": "python3 tools/validate-public-fqdn/validate-public-fqdn.py all --json",
    "packageScript": "public-fqdn:validate",
    "makeTarget": "public-fqdn-validate",
    "selftestCommand": "python3 tools/validate-public-fqdn/validate-public-fqdn.py selftest --json",
