  "validatorRequirements": [
    {
      "id": "validate-mobile-secure-storage-semantics",
      "issueId": "USF-779",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject mobile storage semantics that lack token storage authority, keychain or keystore boundary, local unlock boundary, logout purge, privacy impact, and fail-closed handling."
    },
    {
      "id": "validate-web-secure-cookie-semantics",
      "issueId": "USF-780",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject web session semantics that lack cookie authority, same-site and CSRF boundary, tenant domain scope, logout purge, privacy impact, and fail-closed handling."
    },
    {
      "id": "validate-csrf-cors-csp-semantics",
      "issueId": "USF-781",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject app-surface web security semantics that lack CSRF, CORS, CSP, route, origin, session, provider, dependency, and proof mapping."
    },
    {
      "id": "validate-api-abuse-rate-limit-client-handling",
      "issueId": "USF-782",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject client API handling semantics that lack rate-limit signal mapping, abuse response, retry policy, backoff, user messaging, telemetry, or audit mapping."
    },
    {
      "id": "validate-device-app-integrity-posture",
      "issueId": "USF-783",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject integrity-dependent capability semantics that lack platform posture, unsupported-mode handling, privacy impact, abuse handling, and implementation blocking."
    },
    {
      "id": "validate-jailbreak-root-posture",
      "issueId": "USF-784",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject root-sensitive behaviour semantics that lack posture mapping, user messaging, feature restriction, privacy impact, audit mapping, and owner-approved posture gate."
    },
    {
      "id": "validate-dependency-sbom-sca-policy",
      "issueId": "USF-786",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject release evidence semantics without dependency inventory, SBOM mapping, vulnerability policy, SCA evidence freshness, and stale-evidence fail-closed handling."
    },
    {
      "id": "validate-secrets-config-exposure-scan",
      "issueId": "USF-787",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject app-surface config, release, store metadata, or log semantics that expose governed secrets or lack public/private classification."
    },
    {
      "id": "validate-app-surface-supply-chain-policy",
      "issueId": "USF-790",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject SDK or dependency use semantics without dependency authority, SDK approval gate, native generation review mapping, privacy registry linkage, and proof mapping."
    },
    {
      "id": "validate-third-party-sdk-approval-gate",
      "issueId": "USF-792",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject app-surface SDK use semantics without SDK purpose, data practice, permission, native module, vendor registry, approval, and proof mappings."
    },
    {
      "id": "validate-app-surface-threat-model",
      "issueId": "USF-795",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject app-surface capabilities or SDK semantics that lack threat coverage, mitigation mapping, trust-boundary mapping, privacy impact, and abuse-case handling."
    },
    {
      "id": "validate-app-surface-security-proof-gate",
      "issueId": "USF-796",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject security proof claims when evidence is missing, stale, incomplete, detached from USF semantics, or upgraded from generated reports without underlying evidence."
    }
  ],
  "proofRequirements": [
