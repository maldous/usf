  "purpose": "Define the current-state command surface and CI/local gate for the bounded test-readiness track while USF-234 remains the final acceptance gate.",
  "canonicalCommands": [
    {
      "id": "test-readiness-full",
      "command": "corepack pnpm test-readiness",
      "makeTarget": "test-ready",
      "classification": "canonical-current-test-readiness-gate",
      "requiresComposedServices": true,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "test-readiness:validate",
        "test-readiness:semantic",
        "test-readiness:fixtures",
        "test-readiness:integration",
        "test-readiness:assurance"
      ],
      "claimBoundary": "Runs the bounded local test-readiness command gate, including the composed service integration matrix. USF-234 still owns final acceptance and final test-readiness claim."
    },
    {
      "id": "test-readiness-composed",
      "command": "corepack pnpm test-readiness:composed",
      "makeTarget": "test-composed",
      "classification": "canonical-current-composed-test-gate",
      "requiresComposedServices": true,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "test-readiness:semantic",
        "test-readiness:fixtures",
        "test-readiness:integration"
      ],
      "claimBoundary": "Runs the composed semantic harness, deterministic fixture lifecycle, and composed service integration matrix only."
    },
    {
      "id": "test-readiness-assurance",
      "command": "corepack pnpm test-readiness:assurance",
      "makeTarget": "test-assurance",
      "classification": "canonical-current-assurance-test-gate",
      "requiresComposedServices": true,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "proof:assurance:sonarqube"
      ],
      "claimBoundary": "Runs the bounded local SonarQube zero-open-issue proof for the supported synthetic scan scope."
    },
    {
      "id": "test-readiness-semantic",
      "command": "corepack pnpm test-readiness:semantic",
      "makeTarget": "test-readiness-semantic",
      "classification": "canonical-current-semantic-test-proof",
      "requiresComposedServices": true,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "composed-semantic-test-harness-proof"
      ],
      "claimBoundary": "Executes the supported composed semantic path against the generated test Compose target."
    },
    {
      "id": "test-readiness-fixtures",
      "command": "corepack pnpm test-readiness:fixtures",
      "makeTarget": "test-readiness-fixtures",
      "classification": "canonical-current-fixture-lifecycle-proof",
      "requiresComposedServices": true,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "deterministic-test-fixture-lifecycle-proof"
      ],
      "claimBoundary": "Executes two sequential composed semantic harness runs and verifies deterministic fixture cleanup."
    },
    {
      "id": "test-readiness-integration",
      "command": "corepack pnpm test-readiness:integration",
      "makeTarget": "test-readiness-integration",
      "classification": "canonical-current-composed-service-integration-matrix-proof",
      "requiresComposedServices": true,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "composed-service-integration-matrix-proof"
      ],
      "claimBoundary": "Checks every generated test Compose service, every generated profile, and every service catalogue disposition against the canonical test Compose target. This is not final USF-234 acceptance."
    },
    {
      "id": "test-readiness-validator",
      "command": "corepack pnpm test-readiness:validate",
      "makeTarget": "test-readiness-validate",
      "classification": "canonical-current-test-readiness-validator",
      "requiresComposedServices": false,
      "inMemoryServiceSubstituteAllowed": false,
      "runs": [
        "tools/validate-test-readiness/validate-test-readiness.py"
      ],
      "claimBoundary": "Validates command, service, harness, fixture, Sonar, enterprise evidence, and non-claim metadata. It does not execute Compose by itself."
    }
  ],
  "packageScripts": [
    {
      "id": "test-readiness",
      "script": "pnpm test-readiness:validate && pnpm test-readiness:semantic && pnpm test-readiness:fixtures && pnpm test-readiness:integration && pnpm test-readiness:assurance"
