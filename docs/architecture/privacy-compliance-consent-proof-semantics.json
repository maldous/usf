  "validatorRequirements": [
    {
      "id": "validate-att-tracking-decision-model",
      "issueId": "USF-624",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject ATT tracking semantics that lack tracking purpose mapping, privacy category mapping, ads or analytics dependency mapping, SDK disclosure mapping, proof evidence, or implementation blocking."
    },
    {
      "id": "validate-gdpr-lawful-basis-consent-dsr-model",
      "issueId": "USF-628",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject privacy purposes, consent, withdrawal, export, deletion, or DSR mappings that are absent, ambiguous, detached from governed data inventory, or presented as legal conclusions."
    },
    {
      "id": "validate-international-privacy-jurisdiction-model",
      "issueId": "USF-631",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject launch or policy proof claims for jurisdictions that are unsupported, unmapped, stale, or missing consent and disclosure impact mapping."
    },
    {
      "id": "validate-retention-deletion-export-model",
      "issueId": "USF-635",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject client storage, browser storage, telemetry, or account-flow mappings without retention, export, deletion, purge, and audit semantics."
    },
    {
      "id": "validate-cmp-ump-integration-model",
      "issueId": "USF-641",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject CMP or UMP integration semantics that lack consent update timing, regional applicability, ads and analytics dependency mapping, audit mapping, owner decision dependency, or implementation blocking."
    },
    {
      "id": "validate-analytics-consent-model",
      "issueId": "USF-644",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject analytics event emission semantics that lack purpose mapping, privacy-category mapping, consent-state mapping, suppression semantics, or provider-decision gates."
    },
    {
      "id": "validate-diagnostics-consent-model",
      "issueId": "USF-646",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject crash or performance diagnostic emission semantics that lack consent mapping, privacy mapping, personal-data classification, suppression semantics, or provider-decision gates."
    },
    {
      "id": "validate-privacy-policy-generation-input-model",
      "issueId": "USF-648",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject privacy policy generation inputs that are missing, stale, not tied to governed capabilities, detached from vendor mappings, or presented as legal approval."
    },
    {
      "id": "validate-terms-eula-store-policy-link-model",
      "issueId": "USF-650",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject store metadata or consent surfaces when required policy, terms, EULA, locale, version, or proof-link mappings are absent."
    },
    {
      "id": "validate-privacy-compliance-proof-gate-model",
      "issueId": "USF-652",
      "validatorType": "future-semantic-validator",
      "requirement": "Reject compliance proof claims when evidence is missing, stale, incomplete, detached from USF semantics, or upgraded from a generated report without underlying evidence."
    }
  ],
  "proofRequirements": [
    {
      "id": "prove-att-tracking-decision-model",
      "issueId": "USF-624",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show ATT tracking purpose mapping, privacy category mapping, ads and analytics dependency mapping, SDK disclosure mapping, App Store claim boundary, and implementation blocking."
    },
    {
      "id": "prove-gdpr-lawful-basis-consent-dsr-model",
      "issueId": "USF-628",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show governed data inventory linkage, purpose linkage, consent or withdrawal handling, export and deletion mapping, and audit event mapping. It must not claim GDPR compliance or legal sufficiency."
    },
    {
      "id": "prove-international-privacy-jurisdiction-model",
      "issueId": "USF-631",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show jurisdiction discovery, supported-status mapping, consent impact, disclosure impact, policy variant inputs, and fail-closed handling for unsupported or unmapped jurisdictions."
    },
    {
      "id": "prove-retention-deletion-export-model",
      "issueId": "USF-635",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show retention, deletion, export, purge, and audit mapping for each governed storage or telemetry surface before implementation may proceed."
    },
    {
      "id": "prove-cmp-ump-integration-model",
      "issueId": "USF-641",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show consent update timing, regional applicability, ads and analytics dependency mapping, provider decision dependency, audit mapping, and implementation blocking."
    },
    {
      "id": "prove-analytics-consent-model",
      "issueId": "USF-644",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show analytics purpose mapping, event-category mapping, consent-state mapping, suppression mapping, audit mapping, and implementation blocking until provider decision gates are satisfied."
    },
    {
      "id": "prove-diagnostics-consent-model",
      "issueId": "USF-646",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show diagnostics signal classification, personal-data mapping, consent-state mapping, suppression mapping, audit mapping, and implementation blocking until provider decision gates are satisfied."
    },
    {
      "id": "prove-privacy-policy-generation-input-model",
      "issueId": "USF-648",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show that policy inputs derive from governed data inventory, purposes, retention, vendors, subprocessors, rights channels, and jurisdiction variants without claiming legal approval."
    },
    {
      "id": "prove-terms-eula-store-policy-link-model",
      "issueId": "USF-650",
      "proofType": "future-semantic-proof",
      "expectation": "Proof must show required policy, terms, and EULA links are mapped to locale variants, store metadata, consent surfaces, and version evidence without claiming publication or store readiness."
    },
    {
      "id": "prove-privacy-compliance-proof-gate-model",
      "issueId": "USF-652",
      "proofType": "future-semantic-proof",
      "expectation": "Proof gates must fail closed for missing, stale, incomplete, or detached evidence and must preserve the distinction between raw evidence, semantic evidence, generated reports, and compliance claims."
    }
  ],
  "evidenceFreshnessSemantics": {
    "freshnessRequired": true,
    "missingEvidenceSatisfiesProof": false,
    "staleEvidenceSatisfiesProof": false,
    "unknownEvidenceSatisfiesProof": false,
    "generatedReportSatisfiesProofWithoutUnderlyingEvidence": false,
    "requiredFailureState": "fail-closed"
