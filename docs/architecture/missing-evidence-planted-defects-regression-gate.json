    {
      "id": "root-obligation-manifest-and-validator",
      "ruleRange": "USF-TEST-READINESS-029 through USF-TEST-READINESS-039 and USF-TEST-READINESS-076 through USF-TEST-READINESS-080",
      "prevents": "Missing or stale semantic obligation manifest rows, dependency graph entries, generated Compose coverage, validator wiring, schema registry linkage, or expanded category obligations."
    },
    {
      "id": "command-coverage-sonar-and-lcov",
      "ruleRange": "USF-TEST-READINESS-022 through USF-TEST-READINESS-028 and USF-TEST-READINESS-095 through USF-TEST-READINESS-101",
      "prevents": "Missing command surface, stale package or Make wiring, missing LCOV, stale Sonar import, downgraded coverage threshold, or unapproved exclusion."
    },
    {
      "id": "fixture-seed-reset-cleanup",
      "ruleRange": "USF-TEST-READINESS-040 through USF-TEST-READINESS-046",
      "prevents": "Missing service fixtures, semantic fixtures, seeder resetter cleanup teardown APIs, provenance, repeatability evidence, or test-layer wiring."
    },
    {
      "id": "composed-service-and-profile-exercise",
      "ruleRange": "USF-TEST-READINESS-047 through USF-TEST-READINESS-054",
      "prevents": "Missing generated test Compose service exercise, profile exercise, service catalogue disposition, profile-gated disposition, command linkage, or in-memory service substitute prohibition."
    },
    {
      "id": "semantic-unit-and-functional-regression",
      "ruleRange": "USF-TEST-READINESS-055 through USF-TEST-READINESS-066",
      "prevents": "Missing semantic unit tests, stale mapped test names, unsafe service-backed claims from unit tests, missing functional regression semantic and service mappings, missing behaviour cases, or regression overclaim."
    },
    {
      "id": "enterprise-control-and-iso-supporting-evidence",
      "ruleRange": "USF-TEST-READINESS-067 through USF-TEST-READINESS-075",
      "prevents": "Missing SoA support mapping, evidence register rows, threat model, access posture, resilience posture, incident and vulnerability posture, privacy posture, or certification/readiness overclaim."
    },
    {
      "id": "performance-and-operational-resilience",
      "ruleRange": "USF-TEST-READINESS-081 through USF-TEST-READINESS-094",
      "prevents": "Missing performance budgets, concurrency/resource guardrails, cleanup under pressure, failure-mode coverage, fail-closed audit/observability evidence, reset cleanup teardown evidence, profile failure evidence, or operational overclaim."
    },
    {
      "id": "future-ai-semantic-guardrail",
      "ruleRange": "USF-TEST-READINESS-102 through USF-TEST-READINESS-108",
      "prevents": "Future AI-delivered code, Compose, command, fixture, evidence, or test changes from bypassing semantic obligation, guardrail, diagnostic, generated Compose authority, and non-claim updates."
    },
    {
      "id": "final-planted-defect-regression-evidence",
      "ruleRange": "USF-TEST-READINESS-109 and USF-TEST-READINESS-SELFTEST",
      "prevents": "Treating scattered planted defects as complete without the final aggregate evidence and command gate, or accepting planted defects that no longer fail for their expected rule."
    },
    {
      "id": "test-environment-completion-staging-entry-gate",
      "ruleRange": "USF-TEST-READINESS-110",
      "prevents": "Treating completed child issues as sufficient without a final Test-environment completion evidence map, no-substitute boundary, closure search requirements, staging-entry decision boundary, and enterprise evidence refs."
    },
    {
      "id": "test-readiness-final-acceptance-gate",
      "ruleRange": "USF-TEST-READINESS-111",
      "prevents": "Treating USF-260 staging-entry consideration as final USF-234 test-readiness acceptance without a parent acceptance evidence map, final validation rows, closure search requirements, and non-claim boundaries."
    }
