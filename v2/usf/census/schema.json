{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usf:census:regeneration-census",
  "title": "USF repository regeneration census contract",
  "description": "Closed machine contract for deterministic four-universe census records and closure outputs.",
  "type": "object",
  "required": ["recordType", "record"],
  "properties": {
    "recordType": {
      "enum": ["universe-member", "artifact", "relationship", "inventory", "finding", "coverage", "gap", "output", "replacement", "work-package", "summary", "closure"]
    },
    "record": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confidence": {
      "type": "object",
      "required": ["level", "score", "reasons"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "universeMember": {
      "type": "object",
      "required": ["path", "universe", "sourceState", "contentDigest", "byteSize", "fileMode", "executable", "binary", "extension", "mediaType", "formatKind", "symbolicLinkTarget"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "universe": {"type": "string"},
        "sourceState": {"type": "string"},
        "contentDigest": {"$ref": "#/$defs/digest"},
        "byteSize": {"type": "integer", "minimum": 0},
        "fileMode": {"type": "string", "pattern": "^[0-7]{6}$"},
        "executable": {"type": "boolean"},
        "binary": {"type": "boolean"},
        "extension": {"type": "string"},
        "mediaType": {"type": "string", "minLength": 1},
        "formatKind": {"type": "string", "minLength": 1},
        "symbolicLinkTarget": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "universe", "sourceState", "contentDigest", "mediaType", "fileMode", "formatKind", "artifactFamily", "authorityStatus", "canonicalOutputRequirement", "productionResponsibility", "expectedGenerator", "equivalenceClass", "reuseStrategy", "v2ConceptCoverage", "gapClassification", "requiredSemanticLayers", "implementationSize", "confidence", "riskDrivers", "reasonCodes", "primaryOwner"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "universe": {"type": "string"},
        "sourceState": {"type": "string"},
        "contentDigest": {"$ref": "#/$defs/digest"},
        "mediaType": {"type": "string"},
        "fileMode": {"type": "string"},
        "formatKind": {"type": "string"},
        "artifactFamily": {"type": "string"},
        "authorityStatus": {"type": "string"},
        "canonicalOutputRequirement": {"type": "string"},
        "productionResponsibility": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "expectedGenerator": {"type": ["string", "null"]},
        "equivalenceClass": {"type": "string"},
        "reuseStrategy": {"type": "string"},
        "v2ConceptCoverage": {"type": "string"},
        "gapClassification": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "requiredSemanticLayers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "implementationSize": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "riskDrivers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "primaryOwner": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["source", "relationshipType", "target", "targetKind", "extractionMethod", "confidence", "resolved", "reasonCodes"],
      "properties": {
        "source": {"$ref": "#/$defs/relativePath"},
        "relationshipType": {"type": "string"},
        "target": {"type": "string", "minLength": 1},
        "targetKind": {"type": "string"},
        "extractionMethod": {"type": "string", "minLength": 1},
        "confidence": {"$ref": "#/$defs/confidence"},
        "resolved": {"type": "boolean"},
        "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
