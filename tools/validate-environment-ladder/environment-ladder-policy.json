  "commandContracts": {
    "validateScript": "python3 tools/validate-environment-ladder/validate-environment-ladder.py all --json",
    "selftestScript": "python3 tools/validate-environment-ladder/validate-environment-ladder.py selftest --json",
    "makeValidateTarget": "environment-ladder-validate",
    "makeSelftestTarget": "environment-ladder-selftest",
    "aggregateWiringDeferred": true
  }
