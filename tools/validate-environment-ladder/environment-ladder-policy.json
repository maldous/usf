  "proofBoundaries": [
    {
      "id": "dev-in-memory-first",
      "environmentStage": "dev",
      "permittedProviderModes": [
        "hermetic-mock",
        "local-composed-real-service"
      ],
      "cannotSatisfy": [
        "test-readiness",
        "staging-readiness",
        "production-readiness",
        "live-provider-readiness"
      ]
    },
    {
      "id": "test-compose-required",
      "environmentStage": "test",
      "permittedProviderModes": [
        "local-composed-real-service"
      ],
      "cannotSatisfy": [
        "staging-readiness",
        "production-readiness",
        "live-provider-readiness"
      ]
