{
  "target": "workflow-guardrails",
  "expectedRule": "USF-CI-GUARD-006",
  "records": {
    ".github/workflows/validate-spec.yml": {
      "name": "validate-spec",
      "on": {
        "push": {}
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "validate": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "raw token",
              "env": {
                "API_TOKEN": "not-a-real-token"
              },
              "run": "echo configured"
            }
          ]
        }
      }
    },
    ".github/workflows/proof-anchor.yml": {
      "name": "proof-anchor",
      "on": {
        "push": {
          "branches": [
            "main"
          ]
        }
      },
      "permissions": {
        "contents": "write",
        "id-token": "write",
        "attestations": "write"
      },
      "jobs": {}
    }
  }
}
