{
  "target": "workflow-guardrails",
  "expectedRule": "USF-CI-GUARD-007",
  "records": {
    ".github/workflows/validate-spec.yml": {
      "name": "validate-spec",
      "on": {
        "push": {}
      },
      "permissions": {
        "contents": "read"
      },
      "jobs": {
        "validate": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "actions/cache@v4",
              "with": {
                "path": "node_modules",
                "key": "${{ secrets.CACHE_TOKEN }}"
              }
            }
          ]
        }
      }
    },
    ".github/workflows/proof-anchor.yml": {
      "name": "proof-anchor",
      "on": {
        "push": {
          "branches": [
            "main"
          ]
        }
      },
      "permissions": {
        "contents": "write",
        "id-token": "write",
        "attestations": "write"
      },
      "jobs": {}
    }
  }
}
