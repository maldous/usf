{
  "target": "public-api-readiness-map",
  "expectedRule": "USF-PUBLIC-API-002",
  "clientContractMap": {
    "operations": [
      {
        "routeId": "example.get",
        "clientCallableDisposition": "client-callable-local-contract"
      }
    ]
  },
  "openapiDocument": {
    "x-usf-boundary": {
      "routeContractSource": "packages/contracts/src/api-surface.ts",
      "publicApiReadinessClaim": false,
      "productionReadinessClaim": false,
      "externalSdkReadinessClaim": false
    },
    "paths": {
      "/example": {
        "get": {
          "operationId": "getExample",
          "x-usf-route": {
            "routeId": "example.get",
            "apiVersion": "v1",
            "contractVersion": "api-contracts-1",
            "operationVersion": "1",
            "lifecycle": "experimental",
            "routeClassification": "public",
            "compatibilityPolicy": "breaking changes require version change"
          }
        }
      }
    }
  },
  "record": {
    "authorityLevel": "validator-enforced-readiness-map",
    "readinessScope": "bounded-current-main-public-api-contract-readiness",
    "readinessClaims": {
      "publicApiReady": true,
      "publicApiContractReady": true,
      "publicApiDocumentationReady": true,
      "publicDeploymentReady": false,
      "publicFqdnReady": false,
      "deploymentReady": false,
      "stagingReady": false,
      "productionReady": false,
      "liveProviderReady": false,
      "productUiReady": false,
      "packagePublicationReady": false,
      "complianceReady": false,
      "monetisationReady": false,
      "appStoreReady": false,
      "humanAcceptanceComplete": false
    },
    "operations": [],
    "validatorCoverage": [
      "validate-spec.public-api-readiness-map",
      "openapi:check"
    ],
    "nonClaims": [
      "no-public-deployment-claim",
      "no-public-fqdn-claim",
      "no-staging-claim",
      "no-production-claim",
      "no-live-provider-claim",
      "no-compliance-claim",
      "no-monetisation-claim",
      "no-app-store-claim",
      "no-human-acceptance-claim",
      "no-generated-report-authority-claim"
    ]
  }
}
