  "designIssueId": "USF-976",
  "relatedIssueIds": [
    "USF-603",
    "USF-605",
    "USF-615",
    "USF-616",
    "USF-952",
    "USF-966",
    "USF-975",
    "USF-983"
  ],
  "nonAuthorityStatement": "This validator-owned machine format tracks invalidation enforcement. It does not define USF semantic authority, readiness, staging, production, compliance, store, release, or provider posture.",
  "requiredCoverageTags": [
    "source",
    "semantic",
    "adr",
    "schema",
    "taxonomy",
    "vocabulary",
    "registry",
    "validator",
    "proof",
    "provider",
    "environment",
    "command",
    "dependency",
    "artifact",
    "generated-report",
    "ci-anchor",
    "git",
    "human-decision",
    "configuration"
  ],
  "stalePropagationStates": [
    "current",
    "stale",
    "superseded",
    "historical",
    "invalidated",
    "human-review-required",
    "generated-report-only",
    "terminal-refresh-deferred"
  ],
  "nonPassStates": [
    "stale",
    "superseded",
    "invalidated",
    "human-review-required",
    "generated-report-only",
    "terminal-refresh-deferred"
  ],
  "nonClaims": [
    "no-staging-readiness",
    "no-production-readiness",
    "no-deployment-readiness",
    "no-live-provider-readiness",
    "no-product-readiness",
    "no-store-readiness",
    "no-compliance-readiness",
    "generated-reports-are-not-authority",
    "linear-is-not-semantic-authority"
  ],
  "globalPolicies": {
    "unknownInputFallback": "full-proof-for-affected-family-or-widen-to-all",
    "generatedReportsAreAuthority": false,
    "generatedReportOnlyCanSatisfyProof": false,
    "automaticHumanSignoffAllowed": false,
    "terminalFreshMachineQaIssue": "USF-966",
    "terminalRefreshDeferredCanPass": false,
    "ambiguousProviderFallback": "full-proof-for-affected-family",
    "ambiguousEnvironmentFallback": "full-proof-for-affected-family",
    "proofOverclaimCanPass": false,
    "staleCanPass": false
  },
